import { Button, CheckBox, HorizontalBox, LineEdit, ListView, VerticalBox } from "std-widgets.slint";

export struct ResultItem {
    title: string,
    description: string,
    category: string,
    action: string,
}

component ResultRow inherits Rectangle {
    in property <ResultItem> item;
    in property <bool> selected;
    callback activated();

    height: 54px;
    border-radius: 8px;
    background: selected ? #223049 : (hovered ? #1a2233 : transparent);

    property <bool> hovered: touch.has-hover;

    HorizontalBox {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;

        Rectangle {
            width: 3px;
            border-radius: 2px;
            background: selected ? #7aa2f7 : transparent;
        }

        VerticalBox {
            alignment: center;
            vertical-stretch: 1;
            Text {
                text: item.title;
                color: #e8edf7;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
                vertical-stretch: 1;
            }
            Text {
                text: item.description;
                color: #8d98aa;
                font-size: 12px;
                overflow: elide;
                vertical-stretch: 1;
            }
        }

        Text {
            text: item.category;
            color: #6f7f98;
            font-size: 11px;
            vertical-alignment: center;
        }

        Text {
            text: item.action;
            color: #7aa2f7;
            font-size: 11px;
            vertical-alignment: center;
            visible: item.action != "";
        }
    }

    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

export component AppWindow inherits Window {
    title: "SeekR";
    width: 980px;
    height: 680px;
    background: #10131a;

    in-out property <[ResultItem]> results: [];
    in-out property <int> selected-index: 0;
    in-out property <string> status-text: "Starting…";
    in-out property <string> search-text: "";

    in-out property <string> clock-time: "--:--:--";
    in-out property <bool> clock-enabled: true;
    in-out property <bool> system-enabled: true;
    in-out property <bool> tasks-enabled: true;
    in-out property <bool> weather-enabled: true;
    in-out property <bool> cat-enabled: true;
    in-out property <bool> media-enabled: false;
    in-out property <string> rail-width-text: "196";
    in-out property <string> card-height-text: "140";
    in-out property <string> left-order-text: "clock, system, tasks";
    in-out property <string> right-order-text: "weather, cat, media";

    callback search-changed(string);
    callback clear-requested();
    callback close-requested();
    callback activated(int);
    callback selection-moved(int);
    callback widget-toggled(string, bool);
    callback widget-size-changed(string, string);
    callback widget-order-changed(string, string);

    Rectangle {
        background: #10131a;
        border-radius: 18px;
        border-width: 1px;
        border-color: #293142;

        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.DownArrow) {
                    root.selection-moved(1);
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.selection-moved(-1);
                    return accept;
                }
                if (event.text == Key.Escape) {
                    root.clear-requested();
                    input.clear-focus();
                    return accept;
                }
                reject
            }

            VerticalBox {
                padding: 24px;
                spacing: 14px;

                HorizontalBox {
                    spacing: 12px;
                    Text {
                        text: "SEEKR";
                        color: #e8edf7;
                        font-size: 22px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Find it. Launch it. Get things done.";
                        color: #8d98aa;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Close";
                        clicked => { root.close-requested(); }
                    }
                }

                input := LineEdit {
                    text: root.search-text;
                    placeholder-text: "Search apps and files · calc: 42 * 42 · time:";
                    font-size: 18px;
                    edited(text) => {
                        root.search-text = text;
                        root.search-changed(text);
                    }
                    accepted(text) => { root.activated(root.selected-index); }
                }

                Rectangle {
                    background: #171d28;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #283246;
                    vertical-stretch: 1;
                    min-height: 260px;

                    VerticalBox {
                        padding: 12px;
                        spacing: 6px;

                        HorizontalBox {
                            spacing: 8px;
                            padding-bottom: 6px;
                            Text {
                                text: "RESULTS";
                                color: #8290a7;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: root.status-text;
                                color: #68758a;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            Button {
                                text: "↑";
                                clicked => { root.selection-moved(-1); }
                            }
                            Button {
                                text: "↓";
                                clicked => { root.selection-moved(1); }
                            }
                            Button {
                                text: "Open / Copy";
                                clicked => { root.activated(root.selected-index); }
                            }
                        }

                        if (root.results.length == 0) : Text {
                            text: "Type to search installed applications, Desktop, Documents and Downloads.\n\nEnter opens the selected result, or copies a calculator/time answer.";
                            color: #5d6a80;
                            font-size: 14px;
                            wrap: word-wrap;
                            vertical-stretch: 1;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }

                        if (root.results.length > 0) : ListView {
                            vertical-stretch: 1;
                            for row[index] in root.results : ResultRow {
                                item: row;
                                selected: index == root.selected-index;
                                activated => { root.activated(index); }
                            }
                        }
                    }
                }

                Rectangle {
                    background: #171d28;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #283246;
                    VerticalBox {
                        padding: 12px;
                        spacing: 8px;
                        Text {
                            text: "WIDGET CUSTOMIZATION";
                            color: #8290a7;
                            font-size: 11px;
                            font-weight: 700;
                        }
                        HorizontalBox {
                            spacing: 12px;
                            CheckBox { text: "Clock"; checked: root.clock-enabled; toggled => { root.widget-toggled("clock", self.checked); } }
                            CheckBox { text: "System"; checked: root.system-enabled; toggled => { root.widget-toggled("system", self.checked); } }
                            CheckBox { text: "Tasks"; checked: root.tasks-enabled; toggled => { root.widget-toggled("tasks", self.checked); } }
                            CheckBox { text: "Weather"; checked: root.weather-enabled; toggled => { root.widget-toggled("weather", self.checked); } }
                            CheckBox { text: "Daily cat"; checked: root.cat-enabled; toggled => { root.widget-toggled("cat", self.checked); } }
                            CheckBox { text: "Media"; checked: root.media-enabled; toggled => { root.widget-toggled("media", self.checked); } }
                        }
                        HorizontalBox {
                            spacing: 10px;
                            Text { text: "Clock preview"; color: #aeb9ca; vertical-alignment: center; }
                            Text {
                                text: root.clock-enabled ? root.clock-time : "Disabled";
                                color: #e0e6f0;
                                font-size: 18px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: "Rail width"; color: #aeb9ca; vertical-alignment: center; }
                            LineEdit {
                                text: root.rail-width-text;
                                input-type: number;
                                edited(value) => { root.widget-size-changed("rail_width", value); }
                                width: 70px;
                            }
                            Text { text: "Card height"; color: #aeb9ca; vertical-alignment: center; }
                            LineEdit {
                                text: root.card-height-text;
                                input-type: number;
                                edited(value) => { root.widget-size-changed("card_height", value); }
                                width: 70px;
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "Left order"; color: #aeb9ca; vertical-alignment: center; }
                            LineEdit {
                                text: root.left-order-text;
                                edited(value) => { root.widget-order-changed("left", value); }
                                horizontal-stretch: 1;
                            }
                            Text { text: "Right order"; color: #aeb9ca; vertical-alignment: center; }
                            LineEdit {
                                text: root.right-order-text;
                                edited(value) => { root.widget-order-changed("right", value); }
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }
        }
    }
}
