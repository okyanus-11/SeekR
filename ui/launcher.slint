import { Button, CheckBox, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "SeekR";
    width: 980px;
    height: 620px;
    background: #10131a;

    in-out property <string> results-text: "Start typing to search.";
    in-out property <bool> clock-enabled: true;
    in-out property <bool> system-enabled: true;
    in-out property <bool> tasks-enabled: true;
    in-out property <bool> weather-enabled: true;
    in-out property <bool> cat-enabled: true;
    in-out property <bool> media-enabled: false;
    in-out property <string> rail-width-text: "196";
    in-out property <string> card-height-text: "140";
    in-out property <string> left-order-text: "clock, system, tasks";
    in-out property <string> right-order-text: "weather, cat, media";
    callback search-changed(string);
    callback hide-requested();
    callback widget-toggled(string, bool);
    callback launch-requested();
    callback selection-moved(int);
    callback widget-size-changed(string, string);
    callback widget-order-changed(string, string);

    Rectangle {
        background: #10131a;
        border-radius: 18px;
        border-width: 1px;
        border-color: #293142;

        VerticalBox {
            padding: 28px;
            spacing: 18px;

            HorizontalBox {
                spacing: 12px;
                Text {
                    text: "SEEKR";
                    color: #e8edf7;
                    font-size: 24px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Text {
                    text: "Find it. Launch it. Get things done.";
                    color: #8d98aa;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "Close";
                    clicked => { root.hide-requested(); }
                }
            }

            HorizontalBox {
                spacing: 10px;
                LineEdit {
                    placeholder-text: "Search apps and files · calc: 42 * 42";
                    font-size: 18px;
                    edited(text) => { root.search-changed(text); }
                    horizontal-stretch: 1;
                }
                Button {
                    text: "↑";
                    clicked => { root.selection-moved(-1); }
                }
                Button {
                    text: "↓";
                    clicked => { root.selection-moved(1); }
                }
                Button {
                    text: "Open / Copy selected";
                    clicked => { root.launch-requested(); }
                }
            }

            Rectangle {
                background: #171d28;
                border-radius: 12px;
                border-width: 1px;
                border-color: #283246;
                VerticalBox {
                    padding: 20px;
                    Text {
                        text: "RESULTS";
                        color: #8290a7;
                        font-size: 11px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.results-text;
                        color: #e0e6f0;
                        font-size: 15px;
                        wrap: word-wrap;
                        vertical-stretch: 1;
                    }
                }
                vertical-stretch: 1;
            }

            Rectangle {
                background: #171d28;
                border-radius: 12px;
                border-width: 1px;
                border-color: #283246;
                VerticalBox {
                    padding: 14px;
                    spacing: 8px;
                    Text { text: "WIDGET CUSTOMIZATION"; color: #8290a7; font-size: 11px; font-weight: 700; }
                    HorizontalBox {
                        spacing: 12px;
                        CheckBox { text: "Clock"; checked: root.clock-enabled; toggled => { root.widget-toggled("clock", self.checked); } }
                        CheckBox { text: "System"; checked: root.system-enabled; toggled => { root.widget-toggled("system", self.checked); } }
                        CheckBox { text: "Tasks"; checked: root.tasks-enabled; toggled => { root.widget-toggled("tasks", self.checked); } }
                    }
                    HorizontalBox {
                        spacing: 12px;
                        CheckBox { text: "Weather"; checked: root.weather-enabled; toggled => { root.widget-toggled("weather", self.checked); } }
                        CheckBox { text: "Daily cat"; checked: root.cat-enabled; toggled => { root.widget-toggled("cat", self.checked); } }
                        CheckBox { text: "Media"; checked: root.media-enabled; toggled => { root.widget-toggled("media", self.checked); } }
                    }
                    HorizontalBox {
                        spacing: 10px;
                        Text { text: "Rail width"; color: #aeb9ca; vertical-alignment: center; }
                        LineEdit {
                            text: root.rail-width-text;
                            input-type: number;
                            edited(value) => { root.widget-size-changed("rail_width", value); }
                            width: 76px;
                        }
                        Text { text: "Card height"; color: #aeb9ca; vertical-alignment: center; }
                        LineEdit {
                            text: root.card-height-text;
                            input-type: number;
                            edited(value) => { root.widget-size-changed("card_height", value); }
                            width: 76px;
                        }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: "Left order"; color: #aeb9ca; vertical-alignment: center; }
                        LineEdit {
                            text: root.left-order-text;
                            edited(value) => { root.widget-order-changed("left", value); }
                            horizontal-stretch: 1;
                        }
                        Text { text: "Right order"; color: #aeb9ca; vertical-alignment: center; }
                        LineEdit {
                            text: root.right-order-text;
                            edited(value) => { root.widget-order-changed("right", value); }
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            Text {
                text: "Rust native preview · Search and widget customization";
                color: #68758a;
                font-size: 11px;
            }
        }
    }
}
